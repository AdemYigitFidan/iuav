<?xml version="1.0" ?>
<sdf version="1.9">
  <!-- iuav competition field (based on ardupilot_gazebo iris_runway).
       Layout: docs/plan/iuav_field_layout.png
       ENU frame: x = east, y = north, units in metres.
       Origin = middle of the start/finish line.
       Rules (TEKNOFEST 2026, rotary-wing):
         - Mission 1: take off from the start line, take pole 2 from outside,
           figure-eight x2 around the poles (planned 150 m apart), cross the line.
         - Mission 2: blue hexagon (side 2 m) + red triangle (side 1 m)
           inside the search area (approx. 100 x 30 m), detection only after pole 2.
         - Fixed-wing targets on the same field must NOT be detected:
           4x4 m blue square, 2x2 m red square.
       Collision: only the poles. All ground markings and targets are visual only
       (DART cannot build polyline collisions; the payload rests on the ground,
       5 mm lower, which does not change the horizontal distance score). -->
  <world name="iuav_field">
    <physics name="1ms" type="ignore">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <plugin filename="gz-sim-physics-system"
      name="gz::sim::systems::Physics">
    </plugin>
    <plugin
      filename="gz-sim-sensors-system"
      name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <plugin filename="gz-sim-user-commands-system"
      name="gz::sim::systems::UserCommands">
    </plugin>
    <plugin filename="gz-sim-scene-broadcaster-system"
      name="gz::sim::systems::SceneBroadcaster">
    </plugin>
    <plugin filename="gz-sim-imu-system"
      name="gz::sim::systems::Imu">
    </plugin>
    <plugin filename="gz-sim-navsat-system"
      name="gz::sim::systems::NavSat">
    </plugin>

    <scene>
      <ambient>1.0 1.0 1.0</ambient>
      <background>0.8 0.8 0.8</background>
      <sky></sky>
    </scene>

    <!-- Location: ArduPilot CMAC test site (Canberra). Must match scripts/run_sitl.sh -->
    <spherical_coordinates>
      <latitude_deg>-35.363262</latitude_deg>
      <longitude_deg>149.165237</longitude_deg>
      <elevation>584</elevation>
      <heading_deg>0</heading_deg>
      <surface_model>EARTH_WGS84</surface_model>
    </spherical_coordinates>

    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.8 0.8 0.8 1</specular>
      <attenuation>
        <range>1000</range>
        <constant>0.9</constant>
        <linear>0.01</linear>
        <quadratic>0.001</quadratic>
      </attenuation>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <!-- Axes at the origin (red = x/east, green = y/north, blue = z/up), 10 m each.
         Also carries the navsat sensor. -->
    <model name="axes">
      <static>1</static>
      <link name="link">
        <visual name="r">
          <cast_shadows>0</cast_shadows>
          <pose>5 0 0.1 0 0 0</pose>
          <geometry>
            <box>
              <size>10 0.01 0.01</size>
            </box>
          </geometry>
          <material>
            <ambient>1 0 0 0.8</ambient>
            <diffuse>1 0 0 0.8</diffuse>
            <emissive>1 0 0 0.8</emissive>
            <specular>0.5 0.5 0.5 0.8</specular>
          </material>
        </visual>
        <visual name="g">
          <cast_shadows>0</cast_shadows>
          <pose>0 5 0.1 0 0 0</pose>
          <geometry>
            <box>
              <size>0.01 10 0.01</size>
            </box>
          </geometry>
          <material>
            <ambient>0 1 0 0.8</ambient>
            <diffuse>0 1 0 0.8</diffuse>
            <emissive>0 1 0 0.8</emissive>
            <specular>0.5 0.5 0.5 0.8</specular>
          </material>
        </visual>
        <visual name="b">
          <cast_shadows>0</cast_shadows>
          <pose>0 0 5.1 0 0 0</pose>
          <geometry>
            <box>
              <size>0.01 0.01 10</size>
            </box>
          </geometry>
          <material>
            <ambient>0 0 1 0.8</ambient>
            <diffuse>0 0 1 0.8</diffuse>
            <emissive>0 0 1 0.8</emissive>
            <specular>0.5 0.5 0.5 0.8</specular>
          </material>
        </visual>
        <sensor name="navsat_sensor" type="navsat">
          <always_on>1</always_on>
          <update_rate>1</update_rate>
        </sensor>
      </link>
    </model>

    <!-- Ground with runway (from ardupilot_gazebo) -->
    <include>
      <uri>model://runway</uri>
      <pose degrees="true">-29 545 0 0 0 363</pose>
    </include>

    <!-- ===================== Start / finish ===================== -->
    <!-- Start/finish line: white, 0.3 m wide, 24 m long, along y at x = 0.
         Flight time starts/stops when the drone crosses x = 0. -->
    <model name="start_finish_line">
      <static>true</static>
      <pose>0 0 0.002 0 0 0</pose>
      <link name="link">
        <visual name="visual">
          <cast_shadows>0</cast_shadows>
          <geometry><box><size>0.3 24 0.004</size></box></geometry>
          <material>
            <ambient>0.95 0.95 0.95 1</ambient>
            <diffuse>0.95 0.95 0.95 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- Takeoff / landing pad on the start line: white disc r = 1.5 m with a green "H".
         The drone starts here and lands here after crossing the finish line. -->
    <model name="home_pad">
      <static>true</static>
      <pose>0 -6 0.003 0 0 0</pose>
      <link name="link">
        <visual name="disc">
          <cast_shadows>0</cast_shadows>
          <geometry><cylinder><radius>1.5</radius><length>0.004</length></cylinder></geometry>
          <material>
            <ambient>0.95 0.95 0.95 1</ambient>
            <diffuse>0.95 0.95 0.95 1</diffuse>
          </material>
        </visual>
        <visual name="h_left">
          <cast_shadows>0</cast_shadows>
          <pose>0 0.4 0.003 0 0 0</pose>
          <geometry><box><size>1.2 0.18 0.002</size></box></geometry>
          <material>
            <ambient>0.08 0.52 0.43 1</ambient>
            <diffuse>0.08 0.52 0.43 1</diffuse>
          </material>
        </visual>
        <visual name="h_right">
          <cast_shadows>0</cast_shadows>
          <pose>0 -0.4 0.003 0 0 0</pose>
          <geometry><box><size>1.2 0.18 0.002</size></box></geometry>
          <material>
            <ambient>0.08 0.52 0.43 1</ambient>
            <diffuse>0.08 0.52 0.43 1</diffuse>
          </material>
        </visual>
        <visual name="h_bar">
          <cast_shadows>0</cast_shadows>
          <pose>0 0 0.003 0 0 0</pose>
          <geometry><box><size>0.18 0.8 0.002</size></box></geometry>
          <material>
            <ambient>0.08 0.52 0.43 1</ambient>
            <diffuse>0.08 0.52 0.43 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- ===================== Mission 1: poles ===================== -->
    <!-- 150 m apart (planned distance in the rules), on the x axis.
         Height is not given in the rules; 8 m like last year's world.
         Poles keep their collision: hitting a pole must be a crash in the sim too. -->
    <model name="pole_1">
      <static>true</static>
      <pose>-75 0 4 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><cylinder><radius>0.1</radius><length>8</length></cylinder></geometry>
        </collision>
        <visual name="visual">
          <geometry><cylinder><radius>0.1</radius><length>8</length></cylinder></geometry>
          <material>
            <ambient>0.9 0.45 0.05 1</ambient>
            <diffuse>0.9 0.45 0.05 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <model name="pole_2">
      <static>true</static>
      <pose>75 0 4 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><cylinder><radius>0.1</radius><length>8</length></cylinder></geometry>
        </collision>
        <visual name="visual">
          <geometry><cylinder><radius>0.1</radius><length>8</length></cylinder></geometry>
          <material>
            <ambient>0.9 0.45 0.05 1</ambient>
            <diffuse>0.9 0.45 0.05 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- ===================== Search area ===================== -->
    <!-- 100 m (x: -50..50) x 30 m (y: 30..60), outlined with 0.2 m yellow lines.
         Kept away from the pole turn zones (rules: targets are not placed near them). -->
    <model name="search_area">
      <static>true</static>
      <pose>0 45 0.002 0 0 0</pose>
      <link name="link">
        <visual name="south">
          <cast_shadows>0</cast_shadows>
          <pose>0 -15 0 0 0 0</pose>
          <geometry><box><size>100.2 0.2 0.004</size></box></geometry>
          <material>
            <ambient>0.95 0.8 0.1 1</ambient>
            <diffuse>0.95 0.8 0.1 1</diffuse>
          </material>
        </visual>
        <visual name="north">
          <cast_shadows>0</cast_shadows>
          <pose>0 15 0 0 0 0</pose>
          <geometry><box><size>100.2 0.2 0.004</size></box></geometry>
          <material>
            <ambient>0.95 0.8 0.1 1</ambient>
            <diffuse>0.95 0.8 0.1 1</diffuse>
          </material>
        </visual>
        <visual name="west">
          <cast_shadows>0</cast_shadows>
          <pose>-50 0 0 0 0 0</pose>
          <geometry><box><size>0.2 30.2 0.004</size></box></geometry>
          <material>
            <ambient>0.95 0.8 0.1 1</ambient>
            <diffuse>0.95 0.8 0.1 1</diffuse>
          </material>
        </visual>
        <visual name="east">
          <cast_shadows>0</cast_shadows>
          <pose>50 0 0 0 0 0</pose>
          <geometry><box><size>0.2 30.2 0.004</size></box></geometry>
          <material>
            <ambient>0.95 0.8 0.1 1</ambient>
            <diffuse>0.95 0.8 0.1 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- ===================== Mission 2: targets ===================== -->
    <!-- Blue regular hexagon, side 2 m (4 m corner to corner). Visual only. -->
    <model name="target_hexagon">
      <static>true</static>
      <pose>25 46 0.003 0 0 0</pose>
      <link name="link">
        <visual name="visual">
          <geometry>
            <polyline>
              <point>2 0</point>
              <point>1 1.732</point>
              <point>-1 1.732</point>
              <point>-2 0</point>
              <point>-1 -1.732</point>
              <point>1 -1.732</point>
              <height>0.005</height>
            </polyline>
          </geometry>
          <material>
            <ambient>0.05 0.2 0.85 1</ambient>
            <diffuse>0.05 0.2 0.85 1</diffuse>
            <specular>0.1 0.1 0.1 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <!-- Red equilateral triangle, side 1 m. Visual only. -->
    <model name="target_triangle">
      <static>true</static>
      <pose>-10 48 0.003 0 0 0</pose>
      <link name="link">
        <visual name="visual">
          <geometry>
            <polyline>
              <point>0.577 0</point>
              <point>-0.289 0.5</point>
              <point>-0.289 -0.5</point>
              <height>0.005</height>
            </polyline>
          </geometry>
          <material>
            <ambient>0.85 0.05 0.05 1</ambient>
            <diffuse>0.85 0.05 0.05 1</diffuse>
            <specular>0.1 0.1 0.1 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <!-- ===================== Fixed-wing targets (must be ignored) ===================== -->
    <!-- Same colors as our targets on purpose: vision must separate them by SHAPE, not color.
         Slightly rotated, like on a real field. Visual only. -->
    <model name="square_4x4_blue">
      <static>true</static>
      <pose>-36 42 0.0025 0 0 0.2</pose>
      <link name="link">
        <visual name="visual">
          <geometry><box><size>4 4 0.005</size></box></geometry>
          <material>
            <ambient>0.05 0.2 0.85 1</ambient>
            <diffuse>0.05 0.2 0.85 1</diffuse>
            <specular>0.1 0.1 0.1 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <model name="square_2x2_red">
      <static>true</static>
      <pose>8 36 0.0025 0 0 -0.3</pose>
      <link name="link">
        <visual name="visual">
          <geometry><box><size>2 2 0.005</size></box></geometry>
          <material>
            <ambient>0.85 0.05 0.05 1</ambient>
            <diffuse>0.85 0.05 0.05 1</diffuse>
            <specular>0.1 0.1 0.1 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <!-- ===================== Drone ===================== -->
    <!-- iris + gimbal (ballast) + fixed downward camera, see sim/models/iuav_iris.
         On the home pad, yaw 0 = nose east, towards pole 2 (matches HDG=90 in run_sitl.sh). -->
    <include>
      <uri>model://iuav_iris</uri>
      <pose degrees="true">0 -6 0.195 0 0 0</pose>
    </include>

  </world>
</sdf>
